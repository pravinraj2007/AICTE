# Server-side Gemini configuration. Never put real credentials in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1

# OIDC verification and server-owned subject-to-role mapping.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_SUBJECT_USER_MAP={}
AICTE_DEMO_ROLE_SWITCH_ENABLED=false
DOCUMENT_STORAGE_PATH=

# FastAPI document extraction service.
DOCUMENT_PROCESSOR_URL=http://127.0.0.1:8000
DOCUMENT_PROCESSOR_TOKEN=

# Application URL used for server-side links and callbacks.
APP_URL=http://localhost:3000
