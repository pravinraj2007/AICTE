# AICTE Regulatory Validation Backend Environment Variables
MONGODB_URL=mongodb://localhost:27017/aicte_validation
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional Gemini API Key for assisted document extraction
# Leave empty for purely deterministic validation rules
GEMINI_API_KEY=""

STORAGE_PATH=./uploads/private
ENVIRONMENT=development
